#!/bin/bash

RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
# BLUE="\e[34m"
# BLUE="\[\033[0;34m\]"    # Blue
# MAGENTA="\[\033[0;35m\]" # Magenta
# CYAN="\[\033[0;36m\]"    # Cyan
# WHITE="\[\033[0;37m\]"   # White
RESET="\e[0m"

#==============================================================================
# CONSTANTS
#==============================================================================
readonly VERSION="1.0.0"
readonly ROOT_CONFIG_DIR="$HOME/.config"
readonly THEME_SWITCH_CONFIG_DIR="$ROOT_CONFIG_DIR/theme-switch"
readonly USER_CONFIG_FILE="$HOME/.config/theme-switch/theme.conf"

readonly THEME_SWITCH_TEMP_DIR="$THEME_SWITCH_CONFIG_DIR/templates"

readonly VIM_THEME_DIR="$THEME_SWITCH_CONFIG_DIR/vim-themes"
readonly KITTY_THEME_DIR="$THEME_SWITCH_CONFIG_DIR/kitty-themes"

# TEMPLATE FILES
readonly KITTY_DARK_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/kitty-dark"
readonly KITTY_LIGHT_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/kitty-dark"
readonly NVIM_DARK_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/nvim-dark"
readonly NVIM_LIGHT_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/nvim-light"
readonly VIM_DARK_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/vim-dark"
readonly VIM_LIGHT_THEME_TEMPLATE="$THEME_SWITCH_TEMP_DIR/vim-light"

DEFAULT_VIM_THEME_FILE_PATH="$HOME/.vim/theme.vim"
DEFAULT_KITTY_THEME_FILE_PATH="$ROOT_CONFIG_DIR/kitty/theme.conf"
DEFAULT_NVIM_THEME_FILE_PATH="$ROOT_CONFIG_DIR/nvim/lua/config/theme.lua"

DEFAULT_BACKGROUND_OPACITY=1.00

PRESELECTED_THEMES="/home/caesar/projects/dev-tools/prod/theme-switch/etc/theme-switch/preselected-themes.json"

# production
# PREDEFINED_THEMES="/etc/theme-switch/predefined.json"

#==============================================================================
# HELPER FUNCTIONS
#==============================================================================

initConfig() {

	# GENERATE CONFIGURATION
	echo "Initializing configuration"
	echo "Your default theme? light/dark (default dark): "
	read -p " " user_theme

	# local selected_theme="${user_theme:-dark}"
	local selected_theme="dark"
	local set_vim_theme=true
	local set_nvim_theme=true
	local set_kitty_theme=true

	if [[ "$user_theme" == "light" ]]; then
		selected_theme="light"
	fi

	echo "Are you using Vim? Y/n (default yes)":
	read -p " " use_vim

	[[ "$use_vim" =~ ^(n|N) ]] && set_vim_theme=false

	echo "Are you using Neovim? Y/n (default yes)":
	read -p " " use_nvim

	[[ "$use_nvim" =~ ^(n|N) ]] && set_nvim_theme=false

	echo "Are you using Kitty? Y/n (default yes)":
	read -p " " use_kitty

	[[ "$use_kitty" =~ ^(n|N) ]] && set_kitty_theme=false

	read -p "Path to vim theme (default $DEFAULT_VIM_THEME_FILE_PATH): " selected_vim_theme_file_path
	local vim_theme="${selected_vim_theme_file_path:-$DEFAULT_VIM_THEME_FILE_PATH}"

	read -p "Path to vim theme (default $DEFAULT_NVIM_THEME_FILE_PATH): " selected_nvim_theme_file_path
	local nvim_theme="${selected_nvim_theme_file_path:-$DEFAULT_NVIM_THEME_FILE_PATH}"

	read -p "Path to vim theme (default $DEFAULT_KITTY_THEME_FILE_PATH): " selected_kitty_theme_file_path
	local kitty_theme="${selected_kitty_theme_file_path:-$DEFAULT_KITTY_THEME_FILE_PATH}"

	# uncomment these to debug
	# echo "your selected theme is: $selected_theme"
	# echo "use vim: $set_vim_theme"
	# echo "use nvim: $set_nvim_theme"
	# echo "use kitty: $set_kitty_theme"

	# echo "vim theme location: $vim_theme"
	# echo "nvim theme location: $nvim_theme"
	# echo "kitty theme path: $kitty_theme"

	# cat >"$CONFIG_FILE" <<EOF
	# current_theme=$selected_theme
	# set_vim_theme=$set_vim_theme
	# set_nvim_theme=$set_nvim_theme
	# set_kitty_theme=$set_kitty_theme
	# vim_theme=$vim_theme
	# nvim_theme=$nvim_theme
	# kitty_theme=$kitty_theme
	# EOF

	echo "Configuration saved to $USER_CONFIG_FILE"

	# GENERATE THEME TEMPLATE

	# pick opacity for dark theme: opacity must be number from zero to one with the increment step  of 0.01, valid input will be something like 0.92 or 0.74 or even 1.00
	# pick opacity for light theme: same as before

	read -p "Background opacity for dark theme (default: $DEFAULT_BACKGROUND_OPACITY): " selected_dark_opacity
	# local kitty_theme="${selected_kitty_theme_file_path:-$DEFAULT_KITTY_THEME_FILE_PATH}"
	local dark_opacity=${selected_dark_opacity:-$DEFAULT_BACKGROUND_OPACITY}

	read -p "Background opacity for light theme (default: $DEFAULT_BACKGROUND_OPACITY): " selected_light_opacity
	local light_opacity=${selected_light_opacity:-$DEFAULT_BACKGROUND_OPACITY}

	echo "dark opacity: $dark_opacity"
	echo "light opacity: $light_opacity"

	# PICK NEOVIM COLORSCHEME for light and dark theme: this will be quite complex, read predefined json from file above, list  vim (yes, vim), show diplays names, remember the number, pick from the file_names with the same index, add .vim extension and well use this to do something like this
	#
	# vim.cmd.colorscheme("$nvim_dark_theme_name")
	# vim.opt.background = "dark" or light

	# pick vim colorscheme for light and dark theme
	# same as before but we do vim script way
	#
	# set background=dark
	# colorscheme $vim_dark_theme_name

	# pick kitty theme for dark and light theme, basically the same, in the format of kitty configuration file
	#
	# include ./themes/$kitty_light_theme_name.conf
	# background_opacity 1.00
}

loadConfig() {
	echo -e "${YELLOW}Loading configuration files...${RESET}"

	if [ ! -d "$THEME_SWITCH_CONFIG_DIR" ]; then
		echo -e "${RED}Error: Configuration directory '$THEME_SWITCH_CONFIG_DIR' not found!${RESET}"
		echo -e "${RED}Exiting...${RESET}"
		return 1
	fi

	if [ ! -f "$USER_CONFIG_FILE" ]; then
		echo -e "${RED}Error: Configuration file '$USER_CONFIG_FILE' not found!${RESET}"
		echo -e "${RED}Exiting...${RESET}"
		exit 1
	fi

	# Manually parse the config file instead of sourcing it
	while IFS='=' read -r key value; do
		case "$key" in
		current_theme) current_theme="$value" ;;
		nvim_theme_file_path) nvim_theme_file_path="$value" ;;
		vim_theme_file_path) vim_theme_file_path="$value" ;;
		kitty_theme_file_path) kitty_theme_file_path="$value" ;;
		esac
	done <"$USER_CONFIG_FILE"

	# Ensure required variables are set
	: "${current_theme:=dark}"

	echo -e "${GREEN}Configuration file loaded successfully.${RESET}"
	echo "Current theme: $current_theme"
}

#==============================================================================
# CORE FUNCTIONS
#==============================================================================

printVersion() {
	echo "Theme Switcher Script CLI version $VERSION"
}

printHelp() {
	script_name=$(basename "$0")
	echo "Usage: $script_name [option]"
	echo "Options:"
	echo "  -v, --version                              Show the version number"
	echo "  -t, --toggle                               Toggle between dark and light themes"
	echo "  -r, --reload                               Reload the config after template changes"
	echo "  -s, --set <theme> <program> <colorscheme>  Set a specific theme and colorscheme for a program"
	echo "                                             Example: $script_name -s dark nvim gruvbox"
	echo "  -o, --opacity <opacity> <theme>            Set Kitty Opacity for specific theme"
	echo "                                             Example: $script_name -o 0.90 dark"
	echo "  -d, --detail                               Show current theme details"
}

toggle() {
	loadConfig

	# current_theme is referenced but not assigned
	if [ "$current_theme" = "dark" ]; then
		setTheme "light"
	else
		setTheme "dark"
	fi
}

reloadTheme() {
	echo "Reloading"
	loadConfig
	setTheme "$current_theme"
}

setTheme() {
	local theme="$1" # dark | light
	echo -e "${YELLOW}Setting theme to $theme...${RESET}"

	# Validate theme
	if [[ "$theme" != "dark" && "$theme" != "light" ]]; then
		echo -e "${RED}Error: Invalid theme '$theme'. Use 'dark' or 'light'.${RESET}"
		return 1
	fi

	# Ensure required variables are available
	if [[ -z "$nvim_theme_file_path" || -z "$vim_theme_file_path" || -z "$kitty_theme_file_path" ]]; then
		echo -e "${RED}Error: Theme file paths are not set in the configuration!${RESET}"
		return 1
	fi

	# Select the correct template files
	local kitty_template="$THEME_SWITCH_TEMP_DIR/kitty-$theme"
	local nvim_template="$THEME_SWITCH_TEMP_DIR/nvim-$theme"
	local vim_template="$THEME_SWITCH_TEMP_DIR/vim-$theme"

	# Ensure template files exist before copying
	if [[ ! -f "$kitty_template" || ! -f "$nvim_template" || ! -f "$vim_template" ]]; then
		echo -e "${RED}Error: One or more theme template files are missing!${RESET}"
		return 1
	fi

	# Copy theme files to the configured paths
	cp "$kitty_template" "$kitty_theme_file_path"
	cp "$nvim_template" "$nvim_theme_file_path"
	cp "$vim_template" "$vim_theme_file_path"

	# Update the current theme in the config file
	sed -i "s/^current_theme=.*/current_theme=$theme/" "$USER_CONFIG_FILE"

	echo -e "${GREEN}Theme switched to $theme successfully.${RESET}"
}

setOpacity() {
	echo "setting opacity"
}

viewDetail() {
	echo "Printing current setup"

	loadConfig

	local vim_colorscheme nvim_colorscheme kitty_theme

	vim_colorscheme=$(grep -oP '^colorscheme\s+\K.*' $)

}

#==============================================================================
# CLI HANDLER
#==============================================================================

case "$1" in
-v | --version)
	printVersion
	;;

-h | --help)
	printHelp
	;;

-t | --toggle)
	toggle
	;;

-r | --reload)
	reloadTheme
	;;

-o | --opacity)
	setOpacity
	;;
-i | --init)
	initConfig
	;;

*)
	printHelp
	exit 1
	;;
esac
